<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
    }
    .container {
      padding: 20px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .header {
      background-color: #3b82f6;
      color: white;
      padding: 15px;
      text-align: center;
      border-radius: 8px 8px 0 0;
      margin: -20px -20px 20px;
    }
    .footer {
      margin-top: 30px;
      font-size: 12px;
      color: #6b7280;
      text-align: center;
    }
    .button {
      display: inline-block;
      background-color: #3b82f6;
      color: white;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 4px;
      margin-top: 15px;
    }
    .info-box {
      background-color: #f3f4f6;
      padding: 15px;
      border-radius: 4px;
      margin: 15px 0;
    }
    .notice-box {
      background-color: #fef3c7;
      border-left: 4px solid #f59e0b;
      padding: 15px;
      margin: 15px 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Ride Requested</h1>
    </div>
    
    <p>Hello <%= @passenger.first_name %>,</p>
    
    <p>Your ride request has been submitted successfully!</p>
    
    <div class="info-box">
      <h3>Ride Details</h3>
      <p><strong>From:</strong> <%= @ride.pickup_location %></p>
      <p><strong>To:</strong> <%= @ride.dropoff_location %></p>
      <p><strong>Scheduled Time:</strong> <%= @ride.scheduled_time.strftime("%B %d, %Y at %I:%M %p") %></p>
      <p><strong>Estimated Price:</strong> <%= number_to_currency(@ride.estimated_price) %></p>
      <p><strong>Requested Seats:</strong> <%= @ride.requested_seats %></p>
    </div>
    
    <div class="notice-box">
      <p><strong>What happens next?</strong></p>
      <p>When a driver claims your ride, you will be notified that your ride has been successfully scheduled.</p>
    </div>
    
    <div style="text-align: center;">
      <a href="<%= @url %>/dashboard" class="button">View Your Rides</a>
    </div>
    
    <div class="footer">
      <p>Thank you for choosing RideFlow for your transportation needs.</p>
      <p>© <%= Date.today.year %> RideFlow. All rights reserved.</p>
    </div>
  </div>
</body>
</html> 