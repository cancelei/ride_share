<%= form_with(url: verify_security_code_ride_path(ride), method: :post, class: "mt-4", id: "security_code_form") do |form| %>
  <% if local_assigns[:error].present? %>
    <div class="mb-2 text-red-500 text-sm">
      <%= error %>
    </div>
  <% end %>
  <div class="flex items-center gap-2">
    <%= form.text_field :security_code,
        class: "block w-32 rounded-lg border-2 border-blue-400 bg-white shadow-md focus:border-blue-600 focus:ring-2 focus:ring-blue-500 text-center text-2xl font-bold tracking-widest py-3",
        placeholder: "0000",
        maxlength: 4,
        required: true,
        autocomplete: "off",
        inputmode: "numeric",
        pattern: "[0-9]*" %>
    <%= form.submit "Verify & Start Ride",
        class: "rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-semibold text-white hover:bg-blue-500" %>
  </div>
<% end %> 